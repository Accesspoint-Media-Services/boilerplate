.pagination {
    @include flex-center(row);
    align-items: center;
    gap: rem(22px);
    list-style: none;
    margin: 0;
    &__item {
        &--link {
            padding: rem(8px) rem(12px);
            &.current {
                background-color: $primary-colour;
                @include flex-center(row);
                color: $white;
                align-items: center;
                border-radius: rem(4px);
                transition: all 0.6s ease-in-out;
                cursor: pointer;

                &:hover {
                    background-color: $secondary-colour;
                }
            }

            &.next, &.prev {
                padding: 0;
            }
        }
    }
}