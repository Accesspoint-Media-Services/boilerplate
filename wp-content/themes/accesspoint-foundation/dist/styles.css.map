.team-members {
    &__archive {

        @include background($white, $primary-colour);
        padding: rem(45px) 0;

        &--inner {
            display: flex;
            flex-wrap: wrap;
            gap: rem(30px);

            .team-members__preview {
                flex: 1 1 100%;

                @media (min-width: 992px) {
                    flex: 1 1 calc(50% - rem(15px));
                    max-width: calc(50% - rem(15px));
                }

                @media (min-width: 1200px) {
                    flex: 1 1 calc(33.333% - rem(20px));
                    max-width: calc(33.333% - rem(20px));
                }
            }
        }

        &--navigation {
            width: 100%;
        }
    }
    
    &__preview {
        @include flex-between(column);
        gap: rem(15px);

        &--image {
            width: 100%;
            height: rem(350px);
            border-radius: rem(8px)
        }

        &--meta {
            @include flex-start(column);
            gap: rem(12px);
        }

        &--category{
            a {

            }
        }

        &--title {
            margin: 0
        }

        &--date {
            margin: 0
        }

        &--excerpt {
            p {
                margin-bottom: 0
            }
        }

        &--content {
            @include flex-between(column);
            gap: rem(30px);
            width: 100%;
        }
    }
}