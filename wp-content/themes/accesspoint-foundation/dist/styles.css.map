h1,
h2,
h3,
h4,
h5,
h6 {
    font-family: $heading-font;
    font-weight: 600;
    margin:0 0 rem(20px) 0
}

h1 {}
h2 {}
h3 {}
h4 {}
h5 {}
h6 {}

p {
    margin: 0 0 rem(35px) 0;
}

a {
    text-decoration: none;
    transition: .6s ease-in-out all;
    color: $primary-colour;

    &:visited,
    &:hover,
    &:active {
        color: rgba($primary-colour, .5);
    }
}

ul {
    padding: 0;
    margin: 0 0 0 rem(20px);
    li {
        a {}
    }
}