.back-to-top {
  @include flex-center(row);
  align-items: center;
  position: fixed;
  bottom: rem(30px);
  right: rem(30px);
  width: rem(48px);
  height: rem(48px);
  border-radius: 50%;
  background: $purple;
  color: $white;
  border: none;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(rem(10px));
  transition: .3s ease-in-out all;
  z-index: 50;
  padding: 0;

  &.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  &:hover {
    background: rgba($purple, .8);
  }
}